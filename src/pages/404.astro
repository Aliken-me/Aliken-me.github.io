---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
---

<MainLayout title="404 Not Found">
  <div class="text-center py-20">
    <h1 class="text-6xl font-extrabold text-blue-600 mb-4">404</h1>
    <p class="text-xl text-gray-400 mb-6">Oops! The page you're looking for doesn't exist.</p>
    <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded transition">
      Back to Home
    </a>
  </div>
</MainLayout>
