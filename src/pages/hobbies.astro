---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
---

<MainLayout title="Projects">
  <h2 class="text-3xl font-semibold mb-6">My Hobbies</h2>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <div class="bg-gray-900 p-4 rounded-xl border border-gray-800 transform hover:scale-105 hover:border-blue-500 hover:shadow-xl transition-all duration-300">
      <h3 class="text-xl font-bold mb-2">Watch Anime 💊</h3>
      <p class="text-gray-400 text-sm">A real-time satellite orbit simulation using MATLAB.</p>
    </div>

    <div class="bg-gray-900 p-4 rounded-xl border border-gray-800 transform hover:scale-105 hover:border-blue-500 hover:shadow-xl transition-all duration-300">
      <h3 class="text-xl font-bold mb-2">Learn New Tools 🛠️</h3>
      <p class="text-gray-400 text-sm">A web-based dashboard to visualize aerospace telemetry data.</p>
    </div>

    <div class="bg-gray-900 p-4 rounded-xl border border-gray-800 transform hover:scale-105 hover:border-blue-500 hover:shadow-xl transition-all duration-300">
      <h3 class="text-xl font-bold mb-2">Write My Novels 📚</h3>
      <p class="text-gray-400 text-sm">I tired of boring and new manga and webtoons, I'd prefer to publish my own novel story.</p>
    </div>
  </div>
</MainLayout>

