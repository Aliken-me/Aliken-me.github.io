---
import MainLayout from '../layouts/MainLayout.astro';

const contactMethods = [
  {
    label: "Academic Email",
    value: "ali.morad@sharif.edu",
    href: "mailto:ali.morad@sharif.edu",
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    note: "Primary for academic and research inquiries"
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/Aliken",
    href: "https://www.linkedin.com/in/Aliken",
    icon: "M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 2a2 2 0 11-2 2 2 2 0 012-2z",
    note: "Professional networking and updates"
  },
  {
    label: "GitHub Profile",
    value: "github.com/Aliken-me",
    href: "https://github.com/Aliken-me",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    note: "Open-source repositories, models & codebases"
  },
  {
    label: "Affiliation & Location",
    value: "Sharif University of Technology",
    note: "Department of Aerospace Engineering, Tehran, Iran",
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"
  }
];
---

<MainLayout 
  title="Contact & Inquiries | Ali Moradi" 
  description="Get in touch with Ali Moradi for space engineering research collaborations, CubeSat mission inquiries, or academic projects."
>
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Header -->
    <div class="border-b border-slate-800/80 pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-sky-950/60 text-sky-400 border border-sky-800/50 mb-3">
        Communication
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white">
        Get in Touch
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-2 max-w-2xl leading-relaxed">
        Whether you have questions regarding small satellite mission architectures, numerical simulations in MATLAB, or collaborative research, feel free to reach out.
      </p>
    </div>

    <!-- Main 2-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Direct Contact Info (5 cols) -->
      <div class="lg:col-span-5 space-y-5">
        <div class="space-y-3.5">
          {contactMethods.map((method) => (
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-900/40 border border-slate-800/80 hover:border-slate-700/80 transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center gap-3 mb-1.5">
                  <div class="w-7 h-7 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={method.icon} />
                    </svg>
                  </div>
                  <span class="text-xs font-mono font-medium text-slate-400 uppercase tracking-wider">
                    {method.label}
                  </span>
                </div>

                {method.href ? (
                  <a 
                    href={method.href} 
                    target={method.href.startsWith("http") ? "_blank" : undefined}
                    rel={method.href.startsWith("http") ? "noopener noreferrer" : undefined}
                    class="text-sm sm:text-base font-semibold text-slate-100 group-hover:text-sky-300 transition-colors block break-all"
                  >
                    {method.value} ↗
                  </a>
                ) : (
                  <p class="text-sm sm:text-base font-semibold text-slate-100">
                    {method.value}
                  </p>
                )}

                <p class="text-[11.5px] font-mono text-slate-500 mt-1">
                  {method.note}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- Academic Status Box -->
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-950/60 border border-slate-800/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-mono text-emerald-400 font-semibold tracking-wide">Status: Active Researcher</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Currently active at Sharif University of Technology focusing on M.Sc. thesis research and small satellite subsystem developments.
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Contact Form (7 cols) -->
      <div class="lg:col-span-7 p-7 sm:p-9 rounded-2xl bg-slate-900/40 border border-slate-800/80 backdrop-blur-sm">
        <h2 class="text-lg font-bold text-white mb-1 tracking-tight">
          Send a Direct Message
        </h2>
        <p class="text-xs text-slate-400 mb-6 font-mono">
          Submissions are delivered directly to ali.morad@sharif.edu
        </p>

        <form 
          action="https://formspree.io/f/xnnpakqd" 
          method="POST" 
          class="space-y-4"
        >
          <div>
            <label for="name" class="block text-xs font-mono text-slate-300 uppercase tracking-wider mb-2">
              Your Name
            </label>
            <input 
              type="text" 
              name="name" 
              id="name" 
              required 
              placeholder="e.g. Dr. John Doe"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-950/60 border border-slate-800 text-sm text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-sky-500/70 focus:ring-1 focus:ring-sky-500/40 transition-all font-mono"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono text-slate-300 uppercase tracking-wider mb-2">
              Email Address
            </label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required 
              placeholder="name@institution.edu"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-950/60 border border-slate-800 text-sm text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-sky-500/70 focus:ring-1 focus:ring-sky-500/40 transition-all font-mono"
            />
          </div>

          <div>
            <label for="subject" class="block text-xs font-mono text-slate-300 uppercase tracking-wider mb-2">
              Subject / Topic
            </label>
            <input 
              type="text" 
              name="subject" 
              id="subject" 
              required 
              placeholder="Research Collaboration / CubeSat Payload"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-950/60 border border-slate-800 text-sm text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-sky-500/70 focus:ring-1 focus:ring-sky-500/40 transition-all font-mono"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-mono text-slate-300 uppercase tracking-wider mb-2">
              Message
            </label>
            <textarea 
              name="message" 
              id="message" 
              rows="4" 
              required 
              placeholder="Write your inquiry or project details here..."
              class="w-full px-4 py-2.5 rounded-xl bg-slate-950/60 border border-slate-800 text-sm text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-sky-500/70 focus:ring-1 focus:ring-sky-500/40 transition-all font-mono resize-y"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full sm:w-auto px-7 py-3 rounded-xl text-xs font-mono font-bold bg-sky-500 hover:bg-sky-400 text-slate-950 transition-all shadow-lg shadow-sky-500/20 flex items-center justify-center gap-2"
          >
            <span>Transmit Message</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </div>

    </div>
  </div>
</MainLayout>