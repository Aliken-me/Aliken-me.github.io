---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Aliken | Aerospace & Systems Engineer", 
  description = "Aerospace and Systems Engineer specializing in space systems, MATLAB simulation, and embedded programming." 
} = Astro.props;

const navItems = [
  { name: "Home", href: "/" },
  { name: "Skills", href: "/skills" },
  { name: "Projects", href: "/projects" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#090d16] text-slate-200 font-['Inter',sans-serif] selection:bg-sky-500/30 selection:text-sky-300 min-h-screen flex flex-col antialiased relative overflow-x-hidden">
    <!-- Background Glows -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-sky-600/15 via-indigo-600/10 to-transparent blur-[120px] rounded-full"></div>
      <div class="absolute top-[40%] -left-[15%] w-[500px] h-[500px] bg-cyan-600/10 blur-[140px] rounded-full"></div>
    </div>

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#090d16]/75 border-b border-slate-800/80 transition-all">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group select-none">
          <!-- Clean Floating Logo without Box -->
          <div class="relative flex items-center justify-center">
            <img 
              src="/Aliken Logo v2.svg" 
              alt="Aliken Logo" 
              style="height: 36px; width: auto;" 
              class="brightness-125 contrast-125 drop-shadow-[0_0_12px_rgba(56,189,248,0.25)] transition-transform duration-300 group-hover:scale-105" 
            />
          </div>

          <!-- Crisp Modern Typography -->
          <div class="flex flex-col justify-center">
            <span class="text-[17px] font-semibold tracking-wider text-slate-100 group-hover:text-sky-400 transition-colors">
              ALIKEN
            </span>
            <span class="text-[9.5px] font-mono tracking-[0.22em] text-sky-400/80 uppercase">
              Aerospace & Systems
            </span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
          {navItems.map((item) => (
            <a 
              href={item.href} 
              class="text-slate-400 hover:text-white transition-colors duration-200 relative hover:after:content-[''] hover:after:absolute hover:after:-bottom-1 hover:after:left-0 hover:after:w-full hover:after:h-[2px] hover:after:bg-sky-400 hover:after:rounded-full"
            >
              {item.name}
            </a>
          ))}
          <a
            href="https://github.com/Aliken-me"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-2 px-4 py-1.5 rounded-full text-xs font-['JetBrains_Mono'] border border-slate-700 bg-slate-800/60 hover:bg-slate-700/60 hover:border-sky-500/50 text-slate-300 hover:text-white transition-all flex items-center gap-1.5"
          >
            <span>GitHub</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-6 py-12 md:py-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950/60 backdrop-blur-md mt-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs font-mono text-slate-500 text-center sm:text-left">
          &copy; {new Date().getFullYear()} Ali Moradi. All rights reserved. &bull; SUT Space Systems
        </p>

        <!-- Social & Contact Links -->
        <div class="flex items-center gap-5 text-slate-400">
          <!-- LinkedIn -->
          <a 
            href="https://www.linkedin.com/in/Aliken" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-xs font-mono text-slate-400 hover:text-sky-400 transition-colors flex items-center gap-1.5"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn</span>
          </a>

          <!-- GitHub -->
          <a 
            href="https://github.com/Aliken-me" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-xs font-mono text-slate-400 hover:text-sky-400 transition-colors flex items-center gap-1.5"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>

          <!-- Email -->
          <a 
            href="mailto:ali.morad@sharif.edu" 
            class="text-xs font-mono text-slate-400 hover:text-sky-400 transition-colors flex items-center gap-1.5"
            aria-label="Email"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Email</span>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>